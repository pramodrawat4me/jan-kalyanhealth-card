# Database (docker-compose maps the container's 5432 to host port 5433 to
# avoid clashing with any local Postgres install)
DATABASE_URL=postgresql+psycopg2://janarogya:janarogya@localhost:5433/janarogya

# JWT
JWT_ACCESS_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-a-different-random-64-char-string
JWT_ACCESS_EXPIRES_MINUTES=480
JWT_REFRESH_EXPIRES_DAYS=30

# Aadhaar encryption (32 raw bytes, base64-encoded -> 44 chars)
AADHAAR_ENCRYPTION_KEY=change-this-to-a-base64-encoded-32-byte-key

# App
ENVIRONMENT=development
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
# Comma-separated. In production MUST include the real site origin, e.g.
# https://jankalyanhealthcard.com — the app also auto-includes
# FRONTEND_PUBLIC_URL so the two can't silently drift apart.
CORS_ORIGINS=http://localhost:5173

# File storage
STORAGE_ROOT=./storage
MAX_PHOTO_SIZE_MB=2

# Rate limiting
LOGIN_RATE_LIMIT=5/15minutes
PUBLIC_CARD_RATE_LIMIT=200/minute

# Branding (printed on the card PDF, and served to the frontend preview via
# GET /cards/brand-config — edit here, not in frontend code). The helpline
# numbers, registration fee, and facilities list are NOT here — they're
# admin-editable at runtime via the "Card Settings" page (see CardSettings
# model + /admin/card-settings), seeded automatically on first read.
ORGANIZATION_NAME=Jan Kalyan Health Card
CARD_TAGLINE=स्वस्थ परिवार, सुरक्षित भविष्य
CARD_DISCLAIMER_NOTE=नोट: यह कार्ड एक निजी स्वास्थ्य सदस्यता कार्ड है। यह किसी सरकारी योजना या आयुष्मान भारत कार्ड का विकल्प नहीं है।
